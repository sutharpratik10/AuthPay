# ============================================
# Database Configuration
# ============================================
# Local PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/authpay_db"

# For cloud databases (Aiven, Supabase, Neon, etc.)
# DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# SSL Certificate Configuration (optional, for cloud databases)
DB_USE_CA=false
DB_CERT_PATH="ssl/ca-certificate.pem"

# ============================================
# Application Settings
# ============================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AuthPay"

# Generate a secure secret with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-min-32-characters-long-replace-this"
NEXTAUTH_SECRET="your-super-secret-key-min-32-characters-long-replace-this"

# ============================================
# OAuth Providers Configuration
# ============================================
# See docs/08-OAUTH-SETUP.md for detailed setup instructions

# GitHub OAuth
# 1. Go to: https://github.com/settings/developers
# 2. Create new OAuth App with callback: http://localhost:3000/api/auth/callback/github
# 3. Copy Client ID and generate Client Secret
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Google OAuth
# 1. Go to: https://console.cloud.google.com/
# 2. Create project and enable Google+ API
# 3. Create OAuth 2.0 credentials with callback: http://localhost:3000/api/auth/callback/google
# 4. Copy Client ID and Client Secret
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Microsoft Azure AD OAuth
# 1. Go to: https://portal.azure.com/ > Azure Active Directory
# 2. Register new app with callback: http://localhost:3000/api/auth/callback/azure-ad
# 3. Generate client secret and copy Application ID, Directory ID
# 4. Use "common" for tenant ID to support personal + work/school accounts
AZURE_AD_CLIENT_ID="your-azure-ad-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-ad-client-secret"
AZURE_AD_TENANT_ID="common"

# ============================================
# Email Service Configuration
# ============================================
# SMTP settings for sending emails (verification, password reset, etc.)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-specific-password"
EMAIL_FROM="noreply@yourapp.com"

# ============================================
# Payment Gateway (Razorpay)
# ============================================
# Get test credentials from: https://dashboard.razorpay.com/app/website-app-settings/api-keys

# Server-side secrets (NEVER expose these in frontend)
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# Public key (safe to use in frontend)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# Razorpay Webhook Secret (for payment verification)
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# ============================================
# Development & Debug Settings (Optional)
# ============================================
# Enable debug logging
DEBUG=false

# Enable SQL query logging
LOG_SQL_QUERIES=false

# ============================================
# New Relic APM Monitoring (Optional)
# ============================================
# Get your license key from: https://one.newrelic.com/admin-portal/api-keys/home

# Required: Your New Relic license key
NEW_RELIC_LICENSE_KEY="f1a02b0fb9930c65630f33244908ba16FFFFNRAL"

# Optional: Application name in New Relic dashboard (defaults to Auth-Pay)
NEW_RELIC_APP_NAME="Auth-Pay"

# Optional: Enable AI monitoring features (defaults to true)
NEW_RELIC_AI_MONITORING_ENABLED=true

# Optional: Custom insights events max samples (defaults to 100000)
NEW_RELIC_CUSTOM_INSIGHTS_EVENTS_MAX_SAMPLES_STORED=100000

# Optional: Span events max samples (defaults to 10000)
NEW_RELIC_SPAN_EVENTS_MAX_SAMPLES_STORED=10000

# Optional: Logging level (fatal, error, warn, info, debug, trace)
NEW_RELIC_LOG_LEVEL=info