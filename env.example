# ============================================
# Database Configuration
# ============================================
# Local PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/authpay_db"

# For cloud databases (Aiven, Supabase, Neon, etc.)
# DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# SSL Certificate Configuration (optional, for cloud databases)
DB_USE_CA=false
DB_CERT_PATH="ssl/ca-certificate.pem"

# ============================================
# Application Settings
# ============================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AuthPay"

# Generate a secure secret with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-min-32-characters-long-replace-this"
NEXTAUTH_SECRET="your-super-secret-key-min-32-characters-long-replace-this"

# ============================================
# OAuth Providers (Optional)
# ============================================

# GitHub OAuth
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Google OAuth
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Facebook OAuth
# Get credentials from: https://developers.facebook.com/
FACEBOOK_CLIENT_ID="your-facebook-client-id"
FACEBOOK_CLIENT_SECRET="your-facebook-client-secret"

# Microsoft Azure AD
# Get credentials from: https://portal.azure.com/
AZURE_AD_CLIENT_ID="your-azure-ad-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-ad-client-secret"
AZURE_AD_TENANT_ID="your-azure-ad-tenant-id"

# Apple Sign In
# Get credentials from: https://developer.apple.com/
APPLE_CLIENT_ID="your-apple-service-id"
APPLE_CLIENT_SECRET="your-apple-private-key"

# ============================================
# Email Service Configuration
# ============================================
# SMTP settings for sending emails (verification, password reset, etc.)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-specific-password"
EMAIL_FROM="noreply@yourapp.com"

# ============================================
# Payment Gateway (Razorpay)
# ============================================
# Get test credentials from: https://dashboard.razorpay.com/app/website-app-settings/api-keys

# Server-side secrets (NEVER expose these in frontend)
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# Public key (safe to use in frontend)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# Razorpay Webhook Secret (for payment verification)
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# ============================================
# Development & Debug Settings (Optional)
# ============================================
# Enable debug logging
DEBUG=false

# Enable SQL query logging
LOG_SQL_QUERIES=false